# Copy to .env and adjust. Every value here has a working default in app/core/config.py,
# so .env is optional for local development.

# SQLite file, relative to the backend/ directory.
DATABASE_URL=sqlite:///./cliniccare.db

# Origins allowed to call the API. The Nuxt dev server runs on 3000.
CORS_ORIGINS=["http://localhost:3000"]

DEBUG=false

# Public demo credential for the seeded doctor@cliniccare.local account — not a secret.
DEMO_DOCTOR_PASSWORD=changeme123

# JWT signing secret. Unset by default: a random one is generated at startup and a warning
# is logged, so a fresh clone runs with zero config — the trade-off is that a restart logs
# every doctor out. Set this to keep sessions across restarts.
# JWT_SECRET=

# Minutes before a login session (and its cookie) expires.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Name of the cookie carrying the login session's JWT.
AUTH_COOKIE_NAME=access_token

# Send the auth cookie only over HTTPS. Keep false for local http development.
COOKIE_SECURE=false

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(uv sync:*)",
      "Bash(uv add:*)",
      "Bash(uv lock:*)",
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(uv run alembic:*)",
      "Bash(uv run python:*)",
      "Bash(pnpm install:*)",
      "Bash(pnpm add:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(sqlite3:*)",
      "Read(./backend/**)",
      "Read(./frontend/**)",
      "Edit(./backend/**)",
      "Edit(./frontend/**)"
    ],
    "ask": [
      "Bash(uv run fastapi dev:*)",
      "Bash(pnpm dev:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)"
    ],
    "deny": [
      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(python -m pip:*)",
      "Bash(python -m venv:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(bun:*)",
      "Bash(git push --force:*)",
      "Bash(git checkout .:*)",
      "Bash(rm -rf:*)",
      "Read(./claude-explore/**)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.db)",
      "Read(./**/*.sqlite3)",
      "Read(./**/node_modules/**)",
      "Read(./**/.venv/**)",
      "Read(./**/.nuxt/**)",
      "Read(./**/.output/**)",
      "Read(./**/dist/**)",
      "Read(./**/__pycache__/**)",
      "Read(./frontend/pnpm-lock.yaml)",
      "Read(./backend/uv.lock)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(./claude-explore/**)",
      "Edit(./frontend/pnpm-lock.yaml)",
      "Edit(./backend/uv.lock)",
      "Edit(./**/.nuxt/**)",
      "Edit(./**/node_modules/**)"
    ]
  },
  "env": {
    "PYTHONDONTWRITEBYTECODE": "1"
  }
}
